<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <record id="mail_template_partner_approval_request" model="mail.template">
            <field name="name">Partner: Approval Request</field>
            <field name="model_id" ref="base.model_res_partner"/>
            <field name="subject">Partner {{ object.display_name }} is waiting for approval</field>
            <field name="email_from">{{ (user.email_formatted or '') }}</field>
            <field name="description">Sent to the configured Partner Approvers when a user asks for approval.</field>
            <field name="body_html" type="html">
                <div style="margin:0px;padding:0px;font-size:13px;">
                    <p>Dear Approver,</p>
                    <p>
                        Partner
                        <strong>
                            <a t-attf-href="/odoo/contacts/{{ object.id }}" t-out="object.display_name or ''">Partner</a>
                        </strong>
                        is awaiting your approval.
                    </p>
                    <p t-if="object.vat">GSTIN: <t t-out="object.vat"/></p>
                    <p>Requested by <t t-out="user.name or ''"/>.</p>
                </div>
            </field>
            <field name="auto_delete" eval="True"/>
        </record>

    </data>
</odoo>
