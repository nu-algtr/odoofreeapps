<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <record id="view_partner_title_list" model="ir.ui.view">
            <field name="name">res.partner.title.list</field>
            <field name="model">res.partner.title</field>
            <field name="arch" type="xml">
                <list string="Titles" editable="bottom">
                    <field name="name"/>
                    <field name="shortcut"/>
                </list>
            </field>
        </record>

        <record id="view_partner_title_form" model="ir.ui.view">
            <field name="name">res.partner.title.form</field>
            <field name="model">res.partner.title</field>
            <field name="arch" type="xml">
                <form string="Title">
                    <sheet>
                        <group>
                            <field name="name"/>
                            <field name="shortcut"/>
                            <field name="active" widget="boolean_toggle"/>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="action_partner_title" model="ir.actions.act_window">
            <field name="name">Titles</field>
            <field name="res_model">res.partner.title</field>
            <field name="view_mode">list,form</field>
        </record>

        <menuitem id="menu_partner_title" name="Titles"
                  action="action_partner_title"
                  parent="contacts.res_partner_menu_config" sequence="29"/>

    </data>
</odoo>
